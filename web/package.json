{
  "name": "tickwire-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --noEmit",
    "lint": "oxlint src e2e",
    "test": "vitest run",
    "preview": "vite preview --port 4173",
